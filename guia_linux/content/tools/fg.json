  "brief": {
    "es": "Recupera trabajos en primer plano",
    "en": "Bring jobs to the foreground"
  },
  "category": "processes",
  "level": "beginner",
  "notes": {
    "es": "Consulta jobs antes. %1 significa el trabajo 1, no el PID 1. fg reanuda el trabajo y entrega la terminal al proceso.",
    "en": "Check jobs first. %1 means job 1, not PID 1. fg resumes the job and gives the terminal to the process."
  },
  "sources": [
    "https://www.gnu.org/software/bash/manual/bash.html"
  ],
  "related": [
    "jobs",
    "bg"
  ],
