{
  "name": "crontab",
  "title": {
    "es": "Opciones de CRONTAB",
    "en": "CRONTAB Options"
  },
  "brief": {
    "es": "Programación de tareas periódicas",
    "en": "Periodic task scheduling"
  },
  "category": "system",
  "level": "intermediate",
  "notes": {
    "es": "crontab -r elimina todas las tareas del usuario. El entorno de cron no es el de tu terminal: usa rutas absolutas y configura PATH.",
    "en": "crontab -r deletes all of the user’s jobs. Cron does not use your terminal environment: use absolute paths and configure PATH."
  },
  "sources": [
    "https://github.com/cronie-crond/cronie/blob/master/man/crontab.5"
  ],
  "examples": [
    {
      "id": "crontab.01",
      "text": "Gestión de crontab",
      "description": {
        "es": "Gestión de crontab",
        "en": "Crontab Management"
      },
      "kind": "section"
    },
    {
      "id": "crontab.02",
      "text": "crontab -e",
      "description": {
        "es": "Edita el crontab del usuario actual",
        "en": "Edit the current user's crontab"
      },
      "kind": "command",
      "effect": "write",
      "quick": true
    },
    {
      "id": "crontab.03",
      "text": "crontab -l",
      "description": {
        "es": "Lista las tareas del crontab actual",
        "en": "List current crontab entries"
      },
      "kind": "command",
      "effect": "reference",
      "quick": true
    },
    {
      "id": "crontab.04",
      "text": "crontab -r",
      "description": {
        "es": "Elimina el crontab del usuario actual",
        "en": "Remove the current user's crontab"
      },
      "kind": "command",
      "effect": "delete",
      "quick": false
    },
    {
      "id": "crontab.05",
      "text": "crontab -u user -l",
      "description": {
        "es": "Lista el crontab de otro usuario (requiere root)",
        "en": "List another user's crontab (requires root)"
      },
      "kind": "command",
      "effect": "reference",
      "quick": true
    },
    {
      "id": "crontab.06",
      "text": "crontab file.cron",
      "description": {
        "es": "Instala un crontab desde un archivo",
        "en": "Install a crontab from a file"
      },
      "kind": "command",
      "effect": "write",
      "quick": true
    },
    {
      "id": "crontab.07",
      "text": "Sintaxis de los campos  [min hora día mes día_semana]",
      "description": {
        "es": "Sintaxis de los campos  [min hora día mes día_semana]",
        "en": "Field Syntax  [min hour day month weekday]"
      },
      "kind": "section"
    },
    {
      "id": "crontab.08",
      "text": "* * * * * command",
      "description": {
        "es": "Ejecuta cada minuto",
        "en": "Run every minute"
      },
      "kind": "command",
      "effect": "reference",
      "quick": true
    },
    {
      "id": "crontab.09",
      "text": "0 * * * * command",
      "description": {
        "es": "Ejecuta cada hora (al minuto 0)",
        "en": "Run every hour (at minute 0)"
      },
      "kind": "command",
      "effect": "reference",
      "quick": false
    },
    {
      "id": "crontab.10",
      "text": "0 0 * * * command",
      "description": {
        "es": "Ejecuta cada día a medianoche",
        "en": "Run every day at midnight"
      },
      "kind": "command",
      "effect": "reference",
      "quick": false
    },
    {
      "id": "crontab.11",
      "text": "0 9 * * 1 command",
      "description": {
        "es": "Ejecuta cada lunes a las 9:00",
        "en": "Run every Monday at 9:00"
      },
      "kind": "command",
      "effect": "reference",
      "quick": false
    },
    {
      "id": "crontab.12",
      "text": "0 0 1 * * command",
      "description": {
        "es": "Ejecuta el primer día de cada mes",
        "en": "Run on the first day of every month"
      },
      "kind": "command",
      "effect": "reference",
      "quick": false
    },
    {
      "id": "crontab.13",
      "text": "*/15 * * * * command",
      "description": {
        "es": "Ejecuta cada 15 minutos",
        "en": "Run every 15 minutes"
      },
      "kind": "command",
      "effect": "reference",
      "quick": false
    },
    {
      "id": "crontab.14",
      "text": "0 8-18 * * 1-5 command",
      "description": {
        "es": "Ejecuta cada hora de 8 a 18, de lunes a viernes",
        "en": "Run hourly from 8 to 18, Monday to Friday"
      },
      "kind": "command",
      "effect": "reference",
      "quick": false
    },
    {
      "id": "crontab.15",
      "text": "30 23 * * 0,6 command",
      "description": {
        "es": "Ejecuta a las 23:30 los sábados y domingos",
        "en": "Run at 23:30 on Saturdays and Sundays"
      },
      "kind": "command",
      "effect": "reference",
      "quick": false
    },
    {
      "id": "crontab.16",
      "text": "Variables especiales",
      "description": {
        "es": "Variables especiales",
        "en": "Special Variables"
      },
      "kind": "section"
    },
    {
      "id": "crontab.17",
      "text": "MAILTO=user@example.com",
      "description": {
        "es": "Envía la salida por correo al usuario especificado",
        "en": "Send output by email to the specified user"
      },
      "kind": "command",
      "effect": "reference",
      "quick": false
    },
    {
      "id": "crontab.18",
      "text": "PATH=/usr/local/bin:/usr/bin:/bin",
      "description": {
        "es": "Define el PATH para los comandos del crontab",
        "en": "Set PATH for crontab commands"
      },
      "kind": "command",
      "effect": "reference",
      "quick": false
    },
    {
      "id": "crontab.19",
      "text": "@reboot command",
      "description": {
        "es": "Ejecuta el comando al arrancar el sistema",
        "en": "Run command at system boot"
      },
      "kind": "command",
      "effect": "reference",
      "quick": false
    },
    {
      "id": "crontab.20",
      "text": "@hourly command",
      "description": {
        "es": "Alias de '0 * * * *'",
        "en": "Alias for '0 * * * *'"
      },
      "kind": "command",
      "effect": "reference",
      "quick": false
    },
    {
      "id": "crontab.21",
      "text": "@daily command",
      "description": {
        "es": "Alias de '0 0 * * *'",
        "en": "Alias for '0 0 * * *'"
      },
      "kind": "command",
      "effect": "reference",
      "quick": false
    },
    {
      "id": "crontab.22",
      "text": "@weekly command",
      "description": {
        "es": "Alias de '0 0 * * 0'",
        "en": "Alias for '0 0 * * 0'"
      },
      "kind": "command",
      "effect": "reference",
      "quick": false
    },
    {
      "id": "crontab.23",
      "text": "@monthly command",
      "description": {
        "es": "Alias de '0 0 1 * *'",
        "en": "Alias for '0 0 1 * *'"
      },
      "kind": "command",
      "effect": "reference",
      "quick": false
    }
  ]
}
