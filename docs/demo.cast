[30.08, "o", "\r\n"]
[30.1, "o", "\r\n\u001b[36m  ╔══════════════════════════════════════════════╗\u001b[0m\r\n"]
[30.12, "o", "\u001b[36m  ║  Contar líneas de un archivo                 ║\u001b[0m\r\n\u001b[36m  ╚══════════════════════════════════════════════╝\u001b[0m\r\n\r\n"]
[30.14, "o", "  lh no ejecuta comandos ni crea archivos. Si quieres practicar, copia la preparación en tu\r\n  shell. Solo usa el directorio nuevo; no necesitas root.\r\n"]
[30.16, "o", "\r\n"]
[30.18, "o", "  ▶ Preparación manual (crea archivos de práctica)\r\n  if workdir=$(mktemp -d -t lh-practice.XXXXXX) && cd \"$workdir\"; then\r\n"]
[30.2, "o", "    printf %s 'uno\r\ndos\r\ntres\r\n' > palabras.txt\r\n"]
[30.22, "o", "  else\r\n    printf \"%s\\n\" \"Practice setup failed / Falló la preparación\" >&2\r\n  fi\r\n"]
[30.24, "o", "\r\n"]
[30.26, "o", "  ▶ Reto\r\n"]
[30.28, "o", "  Cuenta las líneas de palabras.txt sin imprimir el nombre del archivo.\r\n\r\n"]
[30.3, "o", "  ▶ Resultado esperado (orden o espacios pueden variar)\r\n  3\r\n"]
[30.32, "o", "  Usa stdin con una redirección de entrada.\r\n"]
[30.34, "o", "  lh practice wc --hint · lh practice wc --solution\r\n"]
[30.36, "o", "  Al terminar, sal de esta carpeta con cd ~. lh no la borra automáticamente.\r\n\r\n"]
[30.38, "o", "  ▶ Fuentes\r\n"]
[30.4, "o", "  https://www.gnu.org/software/bash/manual/bash.html\r\n\r\n"]
[30.42, "o", "\u001b[38;5;244mdemo\u001b[0m:\u001b[1;34m~\u001b[0m$ "]
