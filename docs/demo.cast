[39.32, "o", "\u001b[36m  ║  Uso de ls                                   ║\u001b[0m\r\n\u001b[36m  ╚══════════════════════════════════════════════╝\u001b[0m\r\n\r\n"]
[39.34, "o", "  Comando · Descripción\r\n  ────────────────────────────────────────────────────────────────────────────────────────────\r\n"]
[39.36, "o", "  \u001b[32mls                                                \u001b[0m  \u001b[2mLista el contenido del directorio actual\u001b[0m\r\n  \u001b[32mls -a                                             \u001b[0m  \u001b[2mIncluye archivos ocultos\u001b[0m\r\n  \u001b[32mls -l                                             \u001b[0m  \u001b[2mFormato largo con detalles\u001b[0m\r\n  \u001b[32mls -lh                                            \u001b[0m  \u001b[2mFormato largo con tamaños legibles\u001b[0m\r\n\r\n"]
[39.38, "o", "  Más: lh ls --explain · lh ls\r\n"]
[39.4, "o", "\u001b[38;5;244mdemo\u001b[0m:\u001b[1;34m~\u001b[0m$ "]
