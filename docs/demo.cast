[7.38, "o", "\r\n\u001b[36m  ╔══════════════════════════════════════════════╗\u001b[0m\r\n"]
[7.4, "o", "\u001b[36m  ║  Búsqueda: copiar archivos                   ║\u001b[0m\r\n\u001b[36m  ╚══════════════════════════════════════════════╝\u001b[0m\r\n\r\n"]
[7.42, "o", "  3 resultados\r\n\r\n"]
[7.44, "o", "  ▶ cp\r\n"]
[7.46, "o", "  \u001b[32mcp -i -- origen.txt destino.txt                   \u001b[0m  \u001b[2mPide confirmación antes de sobrescribir\u001b[0m\r\n"]
[7.48, "o", "    Atención: Modifica archivos o estado\r\n"]
[7.5, "o", "  \u001b[32mcp <src> <dst>                                    \u001b[0m  \u001b[2mCopia un archivo\u001b[0m\r\n"]
[7.52, "o", "    Atención: Modifica archivos o estado\r\n  \u001b[32mcp -r <src_dir> <dst>                             \u001b[0m  \u001b[2mCopia un directorio de forma recursiva\u001b[0m\r\n"]
[7.54, "o", "    Atención: Modifica archivos o estado\r\n\r\n"]
