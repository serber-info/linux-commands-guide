[2.2, "o", "\u001b[36m  ║  ls reference                                ║\u001b[0m\r\n\u001b[36m  ╚══════════════════════════════════════════════╝\u001b[0m\r\n\r\n"]
[2.22, "o", "  Command · Description\r\n  ────────────────────────────────────────────────────────────────────────────────────────────\r\n"]
[2.24, "o", "  \u001b[32mls                                                \u001b[0m  \u001b[2mList the current directory contents\u001b[0m\r\n  \u001b[32mls -a                                             \u001b[0m  \u001b[2mInclude hidden files\u001b[0m\r\n  \u001b[32mls -l                                             \u001b[0m  \u001b[2mLong format with details\u001b[0m\r\n  \u001b[32mls -lh                                            \u001b[0m  \u001b[2mLong format with human-readable sizes\u001b[0m\r\n"]
[2.26, "o", "\r\n"]
[2.28, "o", "  More: lh ls --explain · lh ls\r\n"]
[2.3, "o", "\u001b[38;5;244mdemo\u001b[0m:\u001b[1;34m~\u001b[0m$ "]
