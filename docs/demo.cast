[39.92, "o", "\u001b[36m  ║  ls reference                                ║\u001b[0m\r\n\u001b[36m  ╚══════════════════════════════════════════════╝\u001b[0m\r\n"]
[39.94, "o", "\r\n"]
[39.96, "o", "  Command · Description\r\n  ────────────────────────────────────────────────────────────────────────────────────────────\r\n"]
[39.98, "o", "  \u001b[32mls                                                \u001b[0m  \u001b[2mList the current directory contents\u001b[0m\r\n"]
[40.0, "o", "  \u001b[32mls -a                                             \u001b[0m  \u001b[2mInclude hidden files\u001b[0m\r\n"]
[40.02, "o", "  \u001b[32mls -l                                             \u001b[0m  \u001b[2mLong format with details\u001b[0m\r\n  \u001b[32mls -lh                                            \u001b[0m  \u001b[2mLong format with human-readable sizes\u001b[0m\r\n"]
[40.04, "o", "\r\n"]
[40.06, "o", "  More: lh ls --explain · lh ls\r\n"]
[40.08, "o", "\u001b[38;5;244mdemo\u001b[0m:\u001b[1;34m~\u001b[0m$ "]
