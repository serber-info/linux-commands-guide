[8.1, "o", "\r\n\u001b[36m  ╔══════════════════════════════════════════════╗\u001b[0m\r\n"]
[8.12, "o", "\u001b[36m  ║  Búsqueda: espacio disco                     ║\u001b[0m\r\n\u001b[36m  ╚══════════════════════════════════════════════╝\u001b[0m\r\n\r\n"]
[8.14, "o", "  17 resultados\r\n\r\n"]
[8.16, "o", "  ▶ df\r\n"]
[8.18, "o", "  \u001b[32mdf                                                \u001b[0m  \u001b[2mMuestra el espacio en disco de todos los sistemas de archivos\u001b[0m\r\n"]
[8.2, "o", "  \u001b[32mdf -h                                             \u001b[0m  \u001b[2mFormato legible (KB, MB, GB)\u001b[0m\r\n  \u001b[32mdf -H                                             \u001b[0m  \u001b[2mFormato legible usando potencias de 1000\u001b[0m\r\n  \u001b[32mdf -a                                             \u001b[0m  \u001b[2mIncluye sistemas de archivos de tamaño 0\u001b[0m\r\n"]
[8.22, "o", "  \u001b[32mdf -T                                             \u001b[0m  \u001b[2mMuestra el tipo de sistema de archivos\u001b[0m\r\n  \u001b[32mdf -t TYPE                                        \u001b[0m  \u001b[2mMuestra solo sistemas de archivos del tipo indicado\u001b[0m\r\n  \u001b[32mdf -x TYPE                                        \u001b[0m  \u001b[2mExcluye sistemas de archivos del tipo indicado\u001b[0m\r\n"]
[8.24, "o", "  \u001b[32mdf -i                                             \u001b[0m  \u001b[2mMuestra uso de inodos en lugar de bloques\u001b[0m\r\n  \u001b[32mdf --total                                        \u001b[0m  \u001b[2mAñade una línea con el total al final\u001b[0m\r\n  \u001b[32mdf -l                                             \u001b[0m  \u001b[2mMuestra solo sistemas de archivos locales\u001b[0m\r\n"]
[8.26, "o", "  \u001b[32mdf --output=source,size,used,avail                \u001b[0m  \u001b[2mMuestra solo los campos especificados\u001b[0m\r\n  \u001b[32mdf --block-size=1M                                \u001b[0m  \u001b[2mMuestra tamaños en bloques de 1 MB\u001b[0m\r\n  \u001b[32mdf -k                                             \u001b[0m  \u001b[2mMuestra tamaños en bloques de 1024 bytes\u001b[0m\r\n  \u001b[32mdf -m                                             \u001b[0m  \u001b[2mMuestra tamaños en megabytes\u001b[0m\r\n"]
[8.28, "o", "  \u001b[32mdf --inodes                                       \u001b[0m  \u001b[2mMuestra información de inodos\u001b[0m\r\n\r\n"]
[8.3, "o", "  ▶ ncdu\r\n  \u001b[32mncdu -r .                                         \u001b[0m  \u001b[2mExplora el directorio actual sin permitir borrado\u001b[0m\r\n"]
[8.32, "o", "  \u001b[32mncdu -r -x .                                      \u001b[0m  \u001b[2mEvita cruzar a otros sistemas de archivos\u001b[0m\r\n\r\n"]
[8.34, "o", "\u001b[38;5;244mdemo\u001b[0m:\u001b[1;34m~\u001b[0m$ "]
