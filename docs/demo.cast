[15.54, "o", "\r\n\u001b[36m  ╔══════════════════════════════════════════════╗\u001b[0m\r\n\u001b[36m  ║  CHMOD Options                               ║\u001b[0m\r\n\u001b[36m  ╚══════════════════════════════════════════════╝\u001b[0m\r\n\r\n  Avoid 777 as a general fix. +x without a user class is affected by umask; u+x affects only the\r\n  owner. -R affects both directories and files.\r\n\r\n  Command · Description\r\n  ──────────────────────────────────────────────────────────────────────────────────────────────\r\n  \u001b[32mchmod 755 filename\u001b[0m\r\n    rwx for owner, rx for group and others\r\n    Caution: Changes files or state\r\n    u, g and o mean owner, group and others. r, w and x mean read, write and execute. On\r\n    directories, x allows traversal. Do not use 777 to fix permissions without understanding\r\n    them.\r\n\r\n  \u001b[32mchmod 644 filename\u001b[0m\r\n    rw for owner, r for group and others\r\n"]
[15.56, "o", "    Caution: Changes files or state\r\n\r\n  \u001b[32mchmod +x filename\u001b[0m\r\n    Add execution subject to umask (use u+x for the owner only)\r\n"]
