[1.78, "o", "\r\n\u001b[36m  ╔══════════════════════════════════════════════╗\u001b[0m\r\n"]
[1.8, "o", "\u001b[36m  ║  Uso de ls                                   ║\u001b[0m\r\n\u001b[36m  ╚══════════════════════════════════════════════╝\u001b[0m\r\n\r\n"]
[1.82, "o", "  Comando · Descripción\r\n  ────────────────────────────────────────────────────────────────────────────────────────────\r\n"]
[1.84, "o", "  \u001b[32mls                                                \u001b[0m  \u001b[2mLista el contenido del directorio actual\u001b[0m\r\n  \u001b[32mls -a                                             \u001b[0m  \u001b[2mIncluye archivos ocultos\u001b[0m\r\n  \u001b[32mls -l                                             \u001b[0m  \u001b[2mFormato largo con detalles\u001b[0m\r\n"]
[1.86, "o", "  \u001b[32mls -lh                                            \u001b[0m  \u001b[2mFormato largo con tamaños legibles\u001b[0m\r\n\r\n"]
[1.88, "o", "  Más: lh ls --explain · lh ls\r\n"]
